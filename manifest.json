{
  "manifest_version": 3,
  "name": "Lumen - 飞书文档agent",
  "version": "1.0.4",
  "description": "飞书文档agent（非官方版），可连接obsidian为知识库，数据本地存储",
  "key": "",
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https: http://127.0.0.1:* http://localhost:*"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "identity",
    "scripting",
    "unlimitedStorage",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.feishu.cn/*",
    "https://*.larksuite.com/*",
    "https://open.feishu.cn/*",
    "https://open.larksuite.com/*",
    "https://github.com/*",
    "https://weibo.com/*",
    "https://*.weibo.com/*",
    "https://edge.microsoft.com/*",
    "https://api-edge.cognitive.microsofttranslator.com/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "news_referer_ruleset",
        "enabled": true,
        "path": "rules/news_referer.json"
      }
    ]
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.feishu.cn/*",
        "https://*.larksuite.com/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "sandbox": {
    "pages": ["src/sandbox/index.html"]
  },
  "web_accessible_resources": [
    {
      "resources": ["src/sandbox/index.html", "src/viewer/deckViewer.html", "assets/*", "src/sandbox/*"],
      "matches": ["https://*.feishu.cn/*", "https://*.larksuite.com/*"]
    }
  ],
  "action": {
    "default_title": "Lumen - 飞书文档agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
