{
  "name": "feishu-doc-ai-assistant",
  "version": "1.0.0",
  "description": "Lumen — 飞书文档agent：用自然语言操作飞书文档/多维表格/电子表格，数据可视化/PPT/转写，自然语言搞定",
  "license": "Elastic-2.0",
  "author": "hu-qi-jia (https://github.com/hu-qi-jia)",
  "homepage": "https://github.com/hu-qi-jia/Lumen-feishu-Browser-extension",
  "type": "module",
  "scripts": {
    "dev:ui": "vite --config vite.ui.config.ts",
    "dev:ext": "vite",
    "build": "vite build",
    "pack": "node scripts/pack.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:server": "node docs/sim/validate-server.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:store": "node scripts/store-screenshots.mjs",
    "promo": "node scripts/promo-tile.mjs",
    "promo:marquee": "node scripts/promo-marquee.mjs",
    "icons": "node scripts/generate-icons.js",
    "prepare": "npm run icons",
    "test:render": "node scripts/render-test.mjs",
    "docs:html": "node scripts/build-docs.mjs",
    "package:ui": "node scripts/package-ui.mjs"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "jszip": "^3.10.1",
    "openai": "^4.52.0",
    "pdfjs-dist": "^4.10.38",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.5.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "puppeteer": "^25.1.0",
    "sharp": "^0.33.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-web-extension": "^4.1.0",
    "vitest": "^4.1.7"
  }
}
